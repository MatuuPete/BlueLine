# BlueLine environment. Copy to .env and fill in. Never commit .env.
# No secret may use the NEXT_PUBLIC_ prefix.

# Database. "pglite:" = in-memory PGlite, "pglite:<dir>" = on-disk PGlite (dev),
# anything else is a Postgres URL (Neon in prod), e.g. postgres://user:pass@host/db?sslmode=require
DATABASE_URL=pglite:.data/pglite

# Providers: dev and CI use fixtures (only allowed with a pglite: DATABASE_URL; the worker
# refuses fixtures against a real database). Prod: STATS_PROVIDER=espn, ODDS_PROVIDER=sgo|theoddsapi
# (valid ODDS_PROVIDER values: sgo | theoddsapi | fixtures).
STATS_PROVIDER=fixtures
ODDS_PROVIDER=fixtures

# Odds API keys (only the one matching ODDS_PROVIDER is needed)
SGO_API_KEY=
THE_ODDS_API_KEY=
# Monthly unit budget for the odds provider; ingest:odds trims markets to stay under it
ODDS_MONTHLY_BUDGET=2500
# The daily job deletes raw_payloads older than this many days (default 21)
RAW_PAYLOAD_RETENTION_DAYS=21

# Deploying to Vercel? Run `corepack pnpm setup:live` and follow docs/DEPLOY.md: it generates the
# values below for production (deploy/vercel.env, deploy/github-secrets.txt; gitignored).

# Auth.js v5. ALLOWED_EMAILS is a comma list (case-insensitive) of who may sign in.
ALLOWED_EMAILS=you@example.com
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# A provider's sign-in button appears only when both its ID and SECRET are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Self-hosting or `next start` in production mode: set one of these (not needed on Vercel)
AUTH_URL=
AUTH_TRUST_HOST=
# 1 = skip sign-in with a fixed dev user. Ignored when NODE_ENV=production.
AUTH_DEV_BYPASS=0

# Optional: Upstash Redis for the rate limiter (in-memory when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# setup:live non-interactive inputs (see docs/DEPLOY.md). Set them as environment variables for one run;
# keep the owner URL out of this file. SETUP_OWNER_URL=postgresql://owner:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# SETUP_POOLED_URL=   (optional; derived from the owner URL when blank)
# SETUP_SGO_API_KEY=
# SETUP_ALLOWED_EMAILS=you@example.com
