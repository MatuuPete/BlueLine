# BlueLine environment. Copy to .env and fill in. Never commit .env.
# No secret may use the NEXT_PUBLIC_ prefix.

# Database. "pglite:" = in-memory PGlite, "pglite:<dir>" = on-disk PGlite (dev),
# anything else is a Postgres URL (Neon in prod), e.g. postgres://user:pass@host/db?sslmode=require
DATABASE_URL=pglite:.data/pglite

# Providers: dev and CI use fixtures. Prod: STATS_PROVIDER=espn, ODDS_PROVIDER=sgo|theoddsapi
STATS_PROVIDER=fixtures
ODDS_PROVIDER=fixtures

# Odds API keys (only the one matching ODDS_PROVIDER is needed)
SGO_API_KEY=
THE_ODDS_API_KEY=
# Monthly unit budget for the odds provider; ingest:odds trims markets to stay under it
ODDS_MONTHLY_BUDGET=500

# Auth.js v5. ALLOWED_EMAILS is a comma list (case-insensitive) of who may sign in.
ALLOWED_EMAILS=you@example.com
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 1 = skip sign-in with a fixed dev user. Ignored when NODE_ENV=production.
AUTH_DEV_BYPASS=0

# Optional: Upstash Redis for the rate limiter (in-memory when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
