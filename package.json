{
  "name": "blueline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:unit": "vitest run",
    "format": "prettier --write .",
    "e2e": "corepack pnpm --filter @blueline/web e2e",
    "dev": "corepack pnpm --filter @blueline/web dev",
    "worker": "corepack pnpm --filter @blueline/worker start",
    "setup:live": "corepack pnpm --filter @blueline/worker setup:live"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "pnpm": "12.23.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
